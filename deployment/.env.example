GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
POSTGRES_PASSWORD=replace-with-a-local-secret
# Generate once with: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# Back up securely; changing it makes saved personal API keys unreadable.
ARCHLY_AI_ENCRYPTION_KEY=
# Local debugging only. Never enable these in a deployed environment.
ARCHLY_AUTH_DEV_BYPASS=false
VITE_DEV_AUTH=false
